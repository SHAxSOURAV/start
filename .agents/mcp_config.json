{
  "mcpServers": {
    "context7": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "mongodb": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "mongodb-mcp-server",
        "--readOnly"
      ],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "mongodb://localhost:27017/templateDB"
      }
    },
    "redis": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@modelcontextprotocol/server-redis",
        "redis://localhost:6379/0"
      ]
    },
    "cloudinary": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@cloudinary/asset-management-mcp",
        "start"
      ]
    },
    "playwright": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "sequential-thinking": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    }
  }
}
