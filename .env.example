#------------SERVER---------------------------------
NODE_ENV=development
BASE_URL=0.0.0.0
PORT=8001

#------------DATABASE---------------------------------
MONGO_URL=mongodb://localhost:27017/templateDB
DB_NAME=templateDB

#------------AUTH & SECURITY---------------------------------
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=30d

#------------MAIL & SMTP---------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SERVICE=gmail
SMTP_MAIL=example@gmail.com
SMTP_PASSWORD=xxxxxxxxxx
SERVICE_NAME=Mount Fuji

#------------SUPER ADMIN---------------------------------
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-immediately

#------------STRIPE---------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

#------------CLOUDINARY---------------------------------
# CLOUD_NAME=
# API_KEY=
# API_SECRET=
# CLOUDINARY_URL=

#------------TEMPLATE ASSETS---------------------------------
EMAIL_TEMP_IMAGE=https://example.com/logo.png
EMAIL_TEMP_TEXT_SECONDARY_COLOR=#555555

#------------ONESIGNAL---------------------------------
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

#------------OAUTH (GOOGLE & APPLE)---------------------
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

