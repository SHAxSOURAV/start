#----------------------------- SERVER -----------------------------
NODE_ENV=development
BASE_URL=0.0.0.0
PORT=8001

#------------------------ DATABASE & REDIS ------------------------
MONGO_URL=mongodb://localhost:27017/templateDB
DB_NAME=templateDB
REDIS_URL=redis://localhost:6379/0

#------------------------ AUTH & SECURITY ------------------------
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=30d

#-------------------------- SUPER ADMIN --------------------------
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-immediately

#--------------------- OAUTH (GOOGLE & APPLE) ---------------------
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

#------------------------- MEDIA STORAGE -------------------------
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
S3_RETENTION_TEMP_DAYS=2
S3_RETENTION_CHAT_DAYS=180
S3_RETENTION_DOCUMENT_DAYS=365
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

#-------------------------- MAIL & SMTP --------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SERVICE=gmail
SMTP_MAIL=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SERVICE_NAME=Mount Fuji

#--------------------- EMAIL TEMPLATE ASSETS ---------------------
EMAIL_TEMP_IMAGE=https://example.com/logo.png
EMAIL_TEMP_TEXT_SECONDARY_COLOR=#555555

#------------------- ONESIGNAL & NOTIFICATIONS -------------------
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
NOTIFICATION_RETENTION_DAYS=30

#------------------ STRIPE (PAYMENTS & CHECKOUT) ------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

#--------------------------- REVENUECAT ---------------------------
REVENUECAT_ENABLED=false
REVENUECAT_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

#------------------ MONITORING & OBSERVABILITY ------------------
SENTRY_DSN=
